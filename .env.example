TABFM_ACCEPT_NON_COMMERCIAL_LICENSE=false
TABFM_DEVICE=auto
TABFM_MODEL_CACHE_DIR=data/cache/models
TABFM_SESSION_TTL_HOURS=24
TABFM_MAX_UPLOAD_MB=500
TABFM_MAX_DOWNLOAD_MB=500
TABFM_ALLOW_INSECURE_HTTP=false

# Native provider credentials. Never enter raw secrets in app UI.
HF_TOKEN=
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional discovery-only MCP endpoints.
HF_MCP_URL=
KAGGLE_MCP_URL=https://www.kaggle.com/mcp
